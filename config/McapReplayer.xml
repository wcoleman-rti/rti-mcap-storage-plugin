<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/6.1.2/rti_replay_service.xsd">

    <!-- <types>
        <struct name="NddsPingData">
            <member name="number" type="int32" />
        </struct>
        <struct name= "StreamInfoType">
            <member name="disposed" type="boolean"/>
            <member name="topic_name" stringMaxLength="512" type="string"/>
            <member name="type_name" stringMaxLength="512" type="string"/>
            <member name="typecode_buffer" sequenceMaxLength="1024" type="char8"/>
        </struct>
    </types> -->

    <!-- The name of the library, and the function used to create an instance
         of the StorageWriter -->
    <plugin_library name="StorageLibrary">
        <storage_plugin name="McapPlugin">
            <dll>McapStorageReplay</dll>
            <create_function>McapStorageReader_get_storage_reader</create_function>
        </storage_plugin>
    </plugin_library>

    <replay_service name="mcap">
        <!-- Storage properties. These are passed to the plugin in the
             plugin_library -->
        <storage>
            <plugin plugin_name="StorageLibrary::McapPlugin">
                <property>
                    <value>
                        <element>
                            <name>mcap_filepath</name>
                            <value>myRecording.mcap</value>
                            <propagate>0</propagate>
                        </element>
                    </value>
                </property>
            </plugin>
        </storage>

        <!-- Specify playback behavior, including what local time to start -->
        <!-- <playback>
            <enable_looping>true</enable_looping>
        </playback> -->
        <!--playback>
            <fidelity>
                <sampling_period>
                    <sec>0</sec>
                    <nanosec>10000</nanosec>
                </sampling_period>
            </fidelity>
        </playback-->

        <!-- Domain Participant, by default in domain 0. Use the
             -domainIdBase command-line parameter to adjust -->
        <domain_participant name="Domain0">
            <domain_id>0</domain_id>
            <register_type name="PingType" type_ref="NddsPingData"/>
            <!-- <register_type name="StreamInfoType" type_ref="StreamInfoType"/> -->
        </domain_participant>

        <session name="Session">
            <!-- Use only the topic and type this example expects -->
            <!-- <topic name="PingTopic" participant_ref="Domain0">
                <registered_type_name>PingType</registered_type_name>
                <publish_with_original_info>true</publish_with_original_info>
            </topic> -->
            <topic_group name="AllTopics" participant_ref="Domain0">
                <allow_topic_name_filter>*</allow_topic_name_filter>
                <deny_topic_name_filter>rti/*</deny_topic_name_filter>
            </topic_group>
        </session>

    </replay_service>

</dds>
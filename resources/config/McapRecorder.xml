<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/6.1.2/rti_recording_service.xsd">

    <!-- The name of the library, and the function used to create an instance
         of the StorageWriter -->
    <plugin_library name="StorageLibrary">
        <storage_plugin name="McapPlugin">
            <dll>rtirecordingstoragemcaprecord</dll>
            <create_function>McapFileWriter_get_storage_writer</create_function>
        </storage_plugin>
    </plugin_library>

    <!--  A definition of a Recording Service instance to run that
          loads a library written in C  -->
    <recording_service name="mcap">
        <!-- Storage properties. These are passed to the plugin in the
             plugin_library -->
        <storage>
            <plugin plugin_name="StorageLibrary::McapPlugin">
                <property>
                    <value>
                        <element>
                            <!-- Sample data recording file to write to.
                                 **REQUIRED**.
                                 Note: will overwrite existing file.
                                 Note: directory must exist.
                             -->
                            <name>rti.recording.storage.mcap.data_file</name>
                            <value>build/data.mcap</value>
                            <propagate>0</propagate>
                        </element>
                        <element>
                            <!-- Log Verbosity.
                                 Options: SILENT: 0, FATAL: 1, ERROR: 2, [WARN: 3], INFO: 4, DEBUG: 5 -->
                            <name>rti.recording.storage.mcap.logging.log_level</name>
                            <value>3</value>
                            <propagate>0</propagate>
                        </element>
                        <element>
                            <!-- Compression.
                                 Options: [none], lz4, zstd -->
                            <name>rti.recording.storage.mcap.compression.kind</name>
                            <value>none</value>
                            <propagate>0</propagate>
                        </element>
                        <element>
                            <!-- Compression Level.
                                 Options: fastest, fast, [default], slow, slowest -->
                            <name>rti.recording.storage.mcap.compression.level</name>
                            <value>default</value>
                            <propagate>0</propagate>
                        </element>
                    </value>
                </property>
            </plugin>
        </storage>
        <!-- Domain Participant, by default in domain 0. Use the
             -domainIdBase command-line parameter to adjust -->
        <domain_participant name="Domain0">
            <domain_id>0</domain_id>
        </domain_participant>

        <session name="Session">
            <!-- Use only the topic and type this example expects -->

            <topic_group name="AllTopics" participant_ref="Domain0">
                <allow_topic_name_filter>*</allow_topic_name_filter>
                <deny_topic_name_filter>rti/*</deny_topic_name_filter>
            </topic_group>
        </session>
    </recording_service>

</dds>
@PACKAGE_INIT@

set(RTIMcap_FOUND TRUE)
set(_rti_mcap_available_core @RTI_MCAP_BUILD_CORE@)
set(_rti_mcap_available_file @RTI_MCAP_BUILD_FILE@)
set(_rti_mcap_available_storage @RTI_MCAP_BUILD_STORAGE@)
if(NOT RTIMcap_FIND_COMPONENTS)
  set(RTIMcap_FIND_COMPONENTS core file storage)
  foreach(component IN LISTS RTIMcap_FIND_COMPONENTS)
    set(RTIMcap_FIND_REQUIRED_${component} ${_rti_mcap_available_${component}})
  endforeach()
endif()

set(_rti_mcap_load)
foreach(component IN LISTS RTIMcap_FIND_COMPONENTS)
  set(RTIMcap_${component}_FOUND FALSE)
  if(component MATCHES "^(core|file|storage)$" AND _rti_mcap_available_${component})
    set(RTIMcap_${component}_FOUND TRUE)
    list(APPEND _rti_mcap_load "${component}")
    if(component STREQUAL "storage")
      list(APPEND _rti_mcap_load core file)
    endif()
  endif()
endforeach()
check_required_components(RTIMcap)
if(NOT RTIMcap_FOUND)
  set(RTIMcap_NOT_FOUND_MESSAGE "A required RTIMcap component is unknown or was not installed")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RTIMcapDependenciesTargets.cmake")
if(core IN_LIST _rti_mcap_load)
  include("${CMAKE_CURRENT_LIST_DIR}/RTIMcapConnext.cmake")
  if(storage IN_LIST _rti_mcap_load)
    rti_mcap_find_connext(ON PACKAGE)
  else()
    rti_mcap_find_connext(OFF PACKAGE)
  endif()
  if(RTIConnextDDS_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/RTIMcapcoreTargets.cmake")
  else()
    set(RTIMcap_core_FOUND FALSE)
    set(RTIMcap_storage_FOUND FALSE)
    list(REMOVE_ITEM _rti_mcap_load core storage)
    check_required_components(RTIMcap)
    if(NOT RTIMcap_FOUND)
      set(RTIMcap_NOT_FOUND_MESSAGE "Connext DDS 7.7.0 is required by the requested core/storage component")
      return()
    endif()
  endif()
endif()
if(file IN_LIST _rti_mcap_load)
  include("${CMAKE_CURRENT_LIST_DIR}/RTIMcapCompression.cmake")
  if(@RTI_MCAP_ENABLE_LZ4@)
    rti_mcap_find_compression(lz4)
  endif()
  if(@RTI_MCAP_ENABLE_ZSTD@)
    rti_mcap_find_compression(zstd)
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/RTIMcapfileTargets.cmake")
endif()
if(storage IN_LIST _rti_mcap_load)
  include("${CMAKE_CURRENT_LIST_DIR}/RTIMcapstorageTargets.cmake")
endif()

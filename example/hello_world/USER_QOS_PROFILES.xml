<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="file:////rti/ndds/ndds.7.3.0/unlicensed/rti_connext_dds-7.3.0/resource/schema/rti_dds_profiles.xsd">
    <!-- QoS Library containing the QoS profile used in the generated example.

        A QoS library is a named set of QoS profiles.
    -->
    <qos_library name="hello_world_Library">

        <!-- QoS profile used to configure reliable communication between the DataWriter 
             and DataReader created in the example code.

             A QoS profile groups a set of related QoS.
        -->
        <qos_profile name="hello_world_Profile" base_name="BuiltinQosLib::Generic.StrictReliable">
            <!-- QoS used to configure the data writer created in the example code -->                
            <datawriter_qos>
                <publication_name>
                    <name>hello_worldDataWriter</name>
                </publication_name>
            </datawriter_qos>

            <!-- QoS used to configure the data reader created in the example code -->                
            <datareader_qos>
                <subscription_name>
                    <name>hello_worldDataReader</name>
                </subscription_name>
            </datareader_qos>
            <domain_participant_qos>
                <!--
                The participant name, if it is set, will be displayed in the
                RTI tools, making it easier for you to tell one
                application from another when you're debugging.
                -->
                <participant_name>
                    <name>hello_worldParticipant</name>
                    <role_name>hello_worldParticipantRole</role_name>
                </participant_name>

            </domain_participant_qos>
        </qos_profile>


        <!-- QoS Profile to configure the default Domain Participant Factory QoS -->
        <qos_profile name="DefaultDPF_Profile" is_default_participant_factory_profile="true">
            <!-- 
                Domain Participant Factory to create DDS entities as disabled.

                Calling enable() on the participant will recursively enable its underlying entities.
             -->
            <participant_factory_qos>
                <entity_factory>
                    <autoenable_created_entities>false</autoenable_created_entities>
                </entity_factory>
            </participant_factory_qos>
        </qos_profile>

    </qos_library>


    <!-- Domain Library containing the domain, topic, and type used in the example.

        A Domain library is a named set of DDS domains.
    -->
    <domain_library name="hello_world_DomainLibrary">

        <!-- Domain used to define the topics and corresponding types. -->
        <domain name="ExampleDomain" domain_id="0">
            <!-- Register the type in the domain and define a topic using that type. -->
            <register_type name="HelloWorld" />
            <topic name="Example HelloWorld" register_type_ref="HelloWorld" />
        </domain>

    </domain_library>


    <!-- Domain Participant Library containing the DDS participants and underlying DDS entities.

        A Domain Participant library is a named set of DDS participants.
    -->
    <domain_participant_library name="hello_world_ParticipantLibrary">

        <!-- Domain Participant defining a publisher and data writer.

            A domain participant references a named domain.
        -->
        <domain_participant name="hello_worldPublisherParticipant" domain_ref="hello_world_DomainLibrary::ExampleDomain">

            <!-- Specify QoS profile to be applied for the participant. -->
            <domain_participant_qos base_name="hello_world_Library::hello_world_Profile" />
            
            <!-- Publisher entity with a data writer referencing the example topic. -->
            <publisher name="hello_worldPublisher">
                <data_writer name="hello_worldDataWriter" topic_ref="Example HelloWorld">
                    <!-- Specify QoS profile to be applied for the data writer. -->
                    <datawriter_qos base_name="hello_world_Library::hello_world_Profile" />
                </data_writer>
            </publisher>

        </domain_participant>

        <!-- Domain Participant defining a subscriber and data reader.  -->
        <domain_participant name="hello_worldSubscriberParticipant" domain_ref="hello_world_DomainLibrary::ExampleDomain">

            <!-- Specify QoS profile to be applied for the participant -->
            <domain_participant_qos base_name="hello_world_Library::hello_world_Profile" />

            <!-- Subscriber entity with a data reader referencing the example topic. -->
            <subscriber name="hello_worldSubscriber">
                <data_reader name="hello_worldDataReader" topic_ref="Example HelloWorld">
                    <!-- Specify QoS profile to be applied for the data reader. -->
                    <datareader_qos base_name="hello_world_Library::hello_world_Profile" />
                </data_reader>
            </subscriber>

        </domain_participant>
        
    </domain_participant_library>
</dds>
